// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Mission {
  id             String              @id @default(cuid())
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  startedAt      DateTime            @default(now())
  finishedAt     DateTime?
  targetUrl      String
  goal           String
  rationale      String?
  persona        String
  device         String
  status         String
  confusionScore Int?
  priority       String?
  topDiagnosis   String?
  videoUrl       String?
  reportJson     Json?
  rcaJson        Json?
  steps          MissionStep[]
  screenshots    MissionScreenshot[]
}

model MissionStep {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  missionId             String
  stepIndex             Int
  action                String
  diagnosis             String?
  severity              String?
  frustrationLevel      Int?
  verificationOutcome   String?
  verificationVerdict   String?
  currentMilestone      String?
  expectedEffect        String?
  observedEffect        String?
  thought               String?
  evidenceJson          Json?
  contractId            String?
  contractVerdict       String?
  contractConfidence    Float?
  contractReasonsJson   Json?
  mission               Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, stepIndex])
}

model MissionScreenshot {
  id                    String   @id @default(cuid())
  createdAt             DateTime @default(now())
  missionId             String
  stepIndex             Int
  imageUrl              String
  message               String?
  milestone             String?
  action                String?
  diagnosis             String?
  severity              String?
  verification          String?
  verificationReasoning String?
  pageUrl               String?
  mission               Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@index([missionId, stepIndex])
}
